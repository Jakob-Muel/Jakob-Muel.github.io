---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Music"
  description="Listen to Jakob Müller's music on Spotify, SoundCloud, and Bandcamp."
>
  <div class="page-intro">
    <h1>Music</h1>
    <p>I make music. You can find it on the platforms below.</p>
  </div>

  <div class="music-links">

    <a
      class="music-link"
      href="https://open.spotify.com/artist/TODO"
      target="_blank"
      rel="noopener"
    >
      Spotify
      <span class="platform">open.spotify.com ↗</span>
    </a>

    <a
      class="music-link"
      href="https://soundcloud.com/TODO"
      target="_blank"
      rel="noopener"
    >
      SoundCloud
      <span class="platform">soundcloud.com ↗</span>
    </a>

    <a
      class="music-link"
      href="https://TODO.bandcamp.com"
      target="_blank"
      rel="noopener"
    >
      Bandcamp
      <span class="platform">bandcamp.com ↗</span>
    </a>

  </div>

  <p style="margin-top:2rem; font-size:0.85rem; color:var(--muted);">
    <!-- Update the links above with your actual profile URLs. -->
  </p>
</Layout>
