---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <div class="page-intro">
    <h1>Hello, I'm Jakob.</h1>
    <p>
      Tech enthusiast, musician, and cappuccino connoisseur. I love to explore
      the world of tech and always keep an open mind on what's there to come.
    </p>
  </div>

  <section>
    <p>
      I build apps, write about things that interest me, and make music on the
      side. Have a look around.
    </p>
    <ul style="list-style:none; display:flex; flex-direction:column; gap:0.5rem; margin-top:1.5rem;">
      <li><a href="/projects">→ Projects</a> — apps I've built</li>
      <li><a href="/blog">→ Blog</a> — things I've written</li>
      <li><a href="/music">→ Music</a> — things I've made</li>
    </ul>
  </section>
</Layout>
